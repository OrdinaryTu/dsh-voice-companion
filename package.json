{
  "name": "dsh-voice-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Voice input and spoken replies for the DSH Web GUI: local Chinese speech recognition from the Windows recognizer and edge-tts playback in the chosen companion voice.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "scripts/tts.py",
    "scripts/asr.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "voice",
    "tts",
    "asr",
    "companion"
  ],
  "license": "MIT"
}
